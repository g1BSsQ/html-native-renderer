+#[cfg(feature = "svg")]
+fn scoped_svg_db() -> Arc<fontdb::Database> {
+    // Fontdb scans installed files only once per process in the common
+    // opt-in case with no host-injected fonts. The opt-out path never
+    // initializes this global system cache.
+    static SYSTEM_DB: OnceLock<Arc<fontdb::Database>> = OnceLock::new();
+    FONT_DB.with(|slot| {
+        let mut state = slot.borrow_mut();
+        if let Some(db) = &state.db { return Arc::clone(db); }
+        if state.system_fonts && state.supplied.is_empty() {
+            let shared = Arc::clone(SYSTEM_DB.get_or_init(|| {
+                let mut db = fontdb::Database::new();
+                db.load_system_fonts();
+                db.load_font_data(crate::BULLET_FONT.to_vec());
+                Arc::new(db)
+            }));
+            state.db = Some(Arc::clone(&shared));
+            return shared;
+        }
+        let mut db = fontdb::Database::new();
+        if state.system_fonts { db.load_system_fonts(); }
+        db.load_font_data(crate::BULLET_FONT.to_vec());
+        for bytes in &state.supplied {
+            db.load_font_data(decode_font_bytes(bytes).into_owned());
+        }
+        let db = Arc::new(db);
+        state.db = Some(Arc::clone(&db));
+        db
+    })
+}
 
