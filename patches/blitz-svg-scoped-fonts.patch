+use std::sync::Arc;
+#[cfg(feature = "svg")]
+use usvg::fontdb;
+#[cfg(feature = "svg")]
+#[derive(Default)]
+struct SvgFontState {
+    db: Option<Arc<fontdb::Database>>,
+    system_fonts: bool,
+    supplied: Vec<Vec<u8>>,
+}
+#[cfg(feature = "svg")]
+std::thread_local! {
+    static FONT_DB: RefCell<SvgFontState> = RefCell::new(SvgFontState::default());
+}
+#[cfg(feature = "svg")]
+pub struct SvgFontScope {
+    previous: SvgFontState,
+    _thread_bound: PhantomData<Rc<()>>,
+}
+#[cfg(feature = "svg")]
+impl Drop for SvgFontScope {
+    fn drop(&mut self) {
+        FONT_DB.with(|slot| { slot.replace(std::mem::take(&mut self.previous)); });
+    }
+}
+#[cfg(feature = "svg")]
+pub fn svg_font_scope(system_fonts: bool, supplied: &[Vec<u8>]) -> SvgFontScope {
+    // No host font files are opened by scope creation. First SVG use builds db.
+    let state = SvgFontState { db: None, system_fonts, supplied: supplied.to_vec() };
+    let previous = FONT_DB.with(|slot| slot.replace(state));
+    SvgFontScope { previous, _thread_bound: PhantomData }
+}
+#[cfg(feature = "svg")]
+fn scoped_svg_db() -> Arc<fontdb::Database> {
+    FONT_DB.with(|slot| {
+        let mut state = slot.borrow_mut();
+        if let Some(db) = &state.db { return Arc::clone(db); }
+        let mut db = fontdb::Database::new();
+        if state.system_fonts { db.load_system_fonts(); }
+        db.load_font_data(crate::BULLET_FONT.to_vec());
+        for bytes in &state.supplied {
+            db.load_font_data(decode_font_bytes(bytes).into_owned());
+        }
+        let db = Arc::new(db);
+        state.db = Some(Arc::clone(&db));
+        db
+    })
+}
 
