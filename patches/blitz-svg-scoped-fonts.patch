+use std::marker::PhantomData;
+#[cfg(feature = "svg")]
+use std::rc::Rc;
+#[cfg(feature = "svg")]
+use std::sync::Arc;
+#[cfg(feature = "svg")]
+use usvg::fontdb;
+
+// SVG rendering has a document-thread-scoped font database.
+#[cfg(feature = "svg")]
+std::thread_local! {
+    static FONT_DB: RefCell<Arc<fontdb::Database>> =
+        RefCell::new(Arc::new(fontdb::Database::new()));
+}
+#[cfg(feature = "svg")]
+pub struct SvgFontScope {
+    previous: Arc<fontdb::Database>,
+    _thread_bound: PhantomData<Rc<()>>,
+}
+#[cfg(feature = "svg")]
+impl Drop for SvgFontScope {
+    fn drop(&mut self) {
+        FONT_DB.with(|slot| { slot.replace(Arc::clone(&self.previous)); });
+    }
+}
+#[cfg(feature = "svg")]
+pub fn svg_font_scope(system_fonts: bool, supplied: &[Vec<u8>]) -> SvgFontScope {
+    let mut db = fontdb::Database::new();
+    if system_fonts {
+        db.load_system_fonts();
+    }
+    db.load_font_data(crate::BULLET_FONT.to_vec());
+    for bytes in supplied {
+        db.load_font_data(decode_font_bytes(bytes).into_owned());
+    }
+    let previous = FONT_DB.with(|slot| slot.replace(Arc::new(db)));
+    SvgFontScope { previous, _thread_bound: PhantomData }
+}
 
